{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/dashboard/src/*"],
      "@openclasp/protocol": ["packages/protocol/src/index.ts"],
      "@openclasp/core": ["packages/core/src/index.ts"],
      "@openclasp/sdk": ["packages/sdk/src/index.ts"],
      "@openclasp/sidecar": ["packages/sidecar/src/index.ts"],
      "@openclasp/persistence": ["packages/persistence/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps", "packages", "scripts", "tests", "types", "*.ts"],
  "exclude": ["apps/dashboard"]
}
