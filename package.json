{
  "name": "openclasp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -n api,dashboard -c blue,green \"pnpm api\" \"pnpm dashboard\"",
    "api": "tsx apps/api/src/index.ts",
    "dashboard": "vite --config apps/dashboard/vite.config.ts",
    "mcp": "tsx packages/mcp-server/src/index.ts",
    "demo": "tsx apps/demo/src/index.ts",
    "build": "tsup --config tsup.config.ts && vite build --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "schemas": "tsx scripts/export-schemas.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openclasp/core": "workspace:*",
    "@openclasp/mcp-server": "workspace:*",
    "@openclasp/protocol": "workspace:*",
    "fastify": "^5.6.0",
    "jose": "^6.2.10",
    "json-canonicalize": "^3.0.0",
    "mcp-handler": "^2.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
