{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "apps/dashboard/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/mcp.ts": { "maxDuration": 60 },
    "api/cron-feedback.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron-feedback", "schedule": "0 0 * * *" }],
  "rewrites": [
    { "source": "/health", "destination": "/api/index?path=/health" },
    { "source": "/ready", "destination": "/api/index?path=/ready" },
    { "source": "/openapi.json", "destination": "/api/index?path=/openapi.json" },
    { "source": "/extensions/trust/v0.1", "destination": "/api/index?path=/extensions/trust/v0.1" },
    { "source": "/sessions/:id/events", "destination": "/api/index?path=/sessions/:id/events" },
    {
      "source": "/sessions/:id/completion-reports",
      "destination": "/api/index?path=/sessions/:id/completion-reports"
    },
    {
      "source": "/sessions/:id/feedback",
      "destination": "/api/index?path=/sessions/:id/feedback"
    },
    {
      "source": "/a2a/temporary/:id",
      "destination": "/api/index?path=/a2a/temporary/:id"
    },
    { "source": "/agents/:id/card.json", "destination": "/api/index?path=/agents/:id/card.json" },
    {
      "source": "/agents/:id/a2a-agent-card.json",
      "destination": "/api/index?path=/agents/:id/a2a-agent-card.json"
    },
    {
      "source": "/agents/:id/.well-known/openclasp-agent.json",
      "destination": "/api/index?path=/agents/:id/.well-known/openclasp-agent.json"
    },
    { "source": "/v0.1/:path*", "destination": "/api/index?path=/v0.1/:path*" },
    { "source": "/mcp", "destination": "/api/mcp" },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-authorization-server"
    },
    { "source": "/oauth/register", "destination": "/api/oauth-register" },
    { "source": "/oauth/authorize", "destination": "/api/oauth-authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth-token" },
    {
      "source": "/.well-known/openclasp-session-key",
      "destination": "/api/index?path=/.well-known/openclasp-session-key"
    },
    { "source": "/login", "destination": "/" },
    { "source": "/sso-callback", "destination": "/" },
    { "source": "/dashboard", "destination": "/" },
    { "source": "/history", "destination": "/" },
    { "source": "/conversations", "destination": "/" },
    { "source": "/agents", "destination": "/" },
    { "source": "/insights", "destination": "/" },
    { "source": "/connect", "destination": "/" },
    { "source": "/settings", "destination": "/" }
  ]
}
