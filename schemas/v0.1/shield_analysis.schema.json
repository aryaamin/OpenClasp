{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "situationSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "disposition": {
      "type": "string",
      "enum": [
        "proceed",
        "proceed_with_caution",
        "gather_evidence",
        "modify_plan",
        "seek_approval",
        "do_not_proceed"
      ]
    },
    "riskTier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "claims": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "supported",
              "unverified",
              "contradicted",
              "not_checkable"
            ]
          },
          "significance": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidenceReferences": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "claim",
          "status",
          "significance",
          "evidenceReferences",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "manipulationSignals": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tactic": {
            "type": "string",
            "enum": [
              "urgency",
              "authority_claim",
              "emotional_pressure",
              "reciprocity",
              "scarcity",
              "policy_bypass",
              "identity_deception",
              "scope_expansion",
              "data_extraction",
              "inconsistent_claims",
              "none",
              "other"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "significance": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "tactic",
          "observation",
          "confidence",
          "significance"
        ],
        "additionalProperties": false
      }
    },
    "missingEvidence": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "questionsToAsk": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "nextSteps": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "safeguards": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "suggestedResponse": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    }
  },
  "required": [
    "reply",
    "situationSummary",
    "disposition",
    "riskTier",
    "confidence",
    "rationale",
    "claims",
    "manipulationSignals",
    "missingEvidence",
    "questionsToAsk",
    "nextSteps",
    "safeguards"
  ],
  "additionalProperties": false
}
