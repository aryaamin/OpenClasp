{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.1"
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "minLength": 1
    },
    "agentVersion": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assurance": {
      "type": "string",
      "enum": ["oauth_authenticated", "cryptographically_verified"]
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "const": "A2A/1.0"
          },
          "protocolBinding": {
            "default": "JSONRPC",
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["protocol", "protocolBinding", "endpoint"],
        "additionalProperties": false
      }
    },
    "cardUrl": {
      "type": "string",
      "format": "uri"
    },
    "a2aAgentCardUrl": {
      "type": "string",
      "format": "uri"
    },
    "extensionUri": {
      "type": "string",
      "format": "uri"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "protocolVersion",
    "agentId",
    "name",
    "description",
    "framework",
    "agentVersion",
    "capabilities",
    "limitations",
    "assurance",
    "transports",
    "cardUrl",
    "a2aAgentCardUrl",
    "extensionUri",
    "publishedAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
