{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "A2A/1.0"
    },
    "protocolBinding": {
      "default": "JSONRPC",
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "managedBy": {
      "default": "openclasp",
      "type": "string",
      "const": "openclasp"
    }
  },
  "required": ["protocol", "protocolBinding", "endpoint", "managedBy"],
  "additionalProperties": false
}
