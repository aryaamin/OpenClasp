{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "receiptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "interactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentVersions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "contractHash": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "partial", "failure", "cancelled"]
    },
    "commitmentsFulfilled": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitmentsMissed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceHashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyWarnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyViolations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disputeStatus": {
      "type": "string",
      "enum": ["none", "open", "resolved"]
    },
    "delegationChainHash": {
      "type": "string"
    },
    "unilateral": {
      "type": "boolean"
    },
    "provisional": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signatures": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["algorithm", "keyId", "value"],
        "additionalProperties": false
      }
    },
    "completionReportIds": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "conclusionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "platformAttestation": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{43}$"
        }
      },
      "required": ["algorithm", "keyId", "value", "digest"],
      "additionalProperties": false
    }
  },
  "required": [
    "receiptId",
    "interactionId",
    "participants",
    "agentVersions",
    "contractHash",
    "startedAt",
    "completedAt",
    "outcome",
    "commitmentsFulfilled",
    "commitmentsMissed",
    "evidenceHashes",
    "policyWarnings",
    "policyViolations",
    "disputeStatus",
    "delegationChainHash",
    "unilateral",
    "signatures"
  ],
  "additionalProperties": false
}
