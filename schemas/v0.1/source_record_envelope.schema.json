{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operatorId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "schemaName": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{43}$"
    },
    "entityRefs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "string",
      "enum": [
        "self_declared",
        "operator_attested",
        "cryptographically_verified",
        "domain_verified",
        "third_party_verified",
        "observed",
        "disputed"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "local_only",
        "private_requester",
        "private_responder",
        "shared_participants",
        "network_aggregate"
      ]
    },
    "retentionClass": {
      "type": "string",
      "enum": [
        "account",
        "audit",
        "operational",
        "temporary"
      ]
    },
    "learningScope": {
      "type": "string",
      "enum": [
        "not_evaluated",
        "excluded",
        "local_only",
        "network_aggregate"
      ]
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "ingestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "eventId",
    "operatorId",
    "kind",
    "recordId",
    "schemaName",
    "schemaVersion",
    "payload",
    "payloadDigest",
    "entityRefs",
    "provenance",
    "visibility",
    "retentionClass",
    "learningScope",
    "reportedAt",
    "ingestedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
