{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "algorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{43}$"
    }
  },
  "required": ["algorithm", "keyId", "value", "digest"],
  "additionalProperties": false
}
