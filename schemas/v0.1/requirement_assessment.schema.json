{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requirement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "kind": {
      "type": "string",
      "enum": [
        "capability",
        "limitation",
        "success_criterion",
        "deadline",
        "evidence",
        "scope",
        "data",
        "communication",
        "delegation"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["match", "partial", "mismatch", "unknown"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["contract", "self_declared", "eligible_history", "evidence", "version_change"]
      }
    },
    "evidenceReferences": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "required": [
    "requirementId",
    "requirement",
    "kind",
    "status",
    "reason",
    "confidence",
    "sources",
    "evidenceReferences"
  ],
  "additionalProperties": false
}
