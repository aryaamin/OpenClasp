{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "interactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "session_started",
        "message_sent",
        "progress_checkpoint",
        "claim",
        "evidence",
        "correction",
        "constraint",
        "task_result",
        "session_completed",
        "session_failed"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "messageHash": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{43}$"
    },
    "evidenceReferences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "partial"
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "blocked",
            "ready_to_finalize",
            "done",
            "cancelled"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "criteriaMet": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "criteriaRemaining": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "blockerCodes": {
          "default": [],
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          }
        },
        "topicStatus": {
          "type": "string",
          "enum": [
            "in_scope",
            "drifting",
            "changed"
          ]
        },
        "expectedRemainingTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "needsHuman": {
          "default": false,
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "state",
        "progress",
        "criteriaMet",
        "criteriaRemaining",
        "blockerCodes",
        "topicStatus",
        "needsHuman",
        "confidence"
      ],
      "additionalProperties": false
    },
    "details": {
      "default": {
        "labels": [],
        "metrics": {},
        "flags": {}
      },
      "type": "object",
      "properties": {
        "labels": {
          "default": [],
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          }
        },
        "metrics": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "flags": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "labels",
        "metrics",
        "flags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "interactionId",
    "agentId",
    "sequence",
    "type",
    "occurredAt",
    "evidenceReferences",
    "details"
  ],
  "additionalProperties": false
}
