{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feedbackId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "interactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "reviewerAgentId": {
      "type": "string",
      "minLength": 1
    },
    "subjectAgentId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerAgentVersion": {
      "type": "string",
      "minLength": 1
    },
    "ratings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "overall_satisfaction",
          "outcome_satisfaction",
          "communication",
          "timeliness",
          "scope_adherence",
          "evidence_quality",
          "correction_handling",
          "limitation_disclosure",
          "reliability"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "wouldWorkAgain": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unsure"
      ]
    },
    "reasonCodes": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "privateComment": {
      "type": "string",
      "maxLength": 1000
    },
    "evidenceReferences": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "additionalProperties": false
    },
    "submissionMethod": {
      "type": "string",
      "enum": [
        "agent_signature",
        "oauth_account",
        "oauth_installation",
        "agent_access_token",
        "runtime_session"
      ]
    },
    "platformAttestation": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{43}$"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "feedbackId",
    "requestId",
    "interactionId",
    "reviewerAgentId",
    "subjectAgentId",
    "reviewerAgentVersion",
    "ratings",
    "wouldWorkAgain",
    "reasonCodes",
    "evidenceReferences",
    "confidence",
    "submittedAt"
  ],
  "additionalProperties": false
}
