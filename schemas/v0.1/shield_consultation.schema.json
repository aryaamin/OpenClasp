{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.1"
    },
    "consultationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "caseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{43}$"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "reply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "situationSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "disposition": {
          "type": "string",
          "enum": [
            "proceed",
            "proceed_with_caution",
            "gather_evidence",
            "modify_plan",
            "seek_approval",
            "do_not_proceed"
          ]
        },
        "riskTier": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "claims": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "supported",
                  "unverified",
                  "contradicted",
                  "not_checkable"
                ]
              },
              "significance": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "evidenceReferences": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "claim",
              "status",
              "significance",
              "evidenceReferences",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "manipulationSignals": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tactic": {
                "type": "string",
                "enum": [
                  "urgency",
                  "authority_claim",
                  "emotional_pressure",
                  "reciprocity",
                  "scarcity",
                  "policy_bypass",
                  "identity_deception",
                  "scope_expansion",
                  "data_extraction",
                  "inconsistent_claims",
                  "none",
                  "other"
                ]
              },
              "observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "significance": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            },
            "required": [
              "tactic",
              "observation",
              "confidence",
              "significance"
            ],
            "additionalProperties": false
          }
        },
        "missingEvidence": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "questionsToAsk": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "nextSteps": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "safeguards": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "suggestedResponse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      },
      "required": [
        "reply",
        "situationSummary",
        "disposition",
        "riskTier",
        "confidence",
        "rationale",
        "claims",
        "manipulationSignals",
        "missingEvidence",
        "questionsToAsk",
        "nextSteps",
        "safeguards"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ai",
            "fallback"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "tokenUsage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "errorCode": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "mode",
        "model",
        "promptVersion"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "protocolVersion",
    "consultationId",
    "caseId",
    "agentId",
    "inputDigest",
    "analysis",
    "generation",
    "createdAt"
  ],
  "additionalProperties": false
}
