{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claim": {
      "type": "string"
    },
    "claimType": {
      "type": "string",
      "enum": [
        "objective",
        "subjective",
        "prediction"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "supported",
        "contradicted",
        "unverified",
        "not_fact_checkable",
        "insufficient_permission"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceAuthority": {
      "type": "string"
    },
    "sourceFreshness": {
      "type": "string"
    },
    "contradictingEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestedNextAction": {
      "type": "string"
    }
  },
  "required": [
    "claim",
    "claimType",
    "status",
    "confidence",
    "evidenceReferences",
    "sourceAuthority",
    "sourceFreshness",
    "contradictingEvidence",
    "suggestedNextAction"
  ],
  "additionalProperties": false
}
